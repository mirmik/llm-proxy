[Unit]
Description=LLM Proxy — multi-model orchestrator
After=network.target

[Service]
Type=simple
ExecStart="%h/.local/share/llm-proxy/venv/bin/llm-proxy" -c "%h/.config/llm-proxy/config.yaml" serve
# Let the proxy persist slot state before it terminates its llama-server children.
# Any children left after the graceful timeout are still killed as a group.
KillMode=mixed
TimeoutStopSec=15
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
